{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kids-hearts-clinic",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only the appointment form goes through worker.js; every page and file is served as before
    "run_worker_first": ["/api/*"]
  },
  // Appointment form: at most 5 requests a minute from one visitor
  "ratelimits": [
    { "name": "CONTACT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "routes": [
    { "pattern": "kidsheartsclinic.com", "custom_domain": true },
    { "pattern": "www.kidsheartsclinic.com", "custom_domain": true }
  ]
}
